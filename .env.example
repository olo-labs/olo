# Olo Backend — environment variables (copy to .env to override)
# Spring Boot maps these to application.properties (e.g. SERVER_PORT → server.port).
# Used by: docker compose, bootRun, or any process that loads .env.

# Server
SERVER_PORT=7080

# Olo backend version string (GET /api/ui/context → oloVersion)
OLO_VERSION=v1.0.0-Dev

# Swagger UI (set false in production to disable /swagger-ui.html and /api-docs)
OLO_SWAGGER_UI_ENABLED=true

# Cache / Redis (session persistence)
OLO_CACHE_HOST=localhost
OLO_CACHE_PORT=46379
OLO_CACHE_DATABASE=0

# Temporal server (task queue + workflow type come from workflow.json under OLO_CONFIGURATION_DIR)
OLO_TEMPORAL_TARGET=localhost:7233

# Callback URL the worker uses to POST run events (must be reachable by the worker)
OLO_CHAT_CALLBACK_BASE_URL=http://localhost:7080

# WebSocket (dev/demo: false; production: true)
# Identity (required): the IdP that signs sign-in tokens, and the audience they must carry.
OLO_SECURITY_ISSUER=https://idp.example.com/realms/olo
OLO_SECURITY_AUDIENCE=olo-api
# OLO_SECURITY_JWK_SET_URI=https://idp.example.com/realms/olo/protocol/openid-connect/certs
# Worker callback signing key (same id and key on the worker; at least 32 bytes).
OLO_CALLBACK_KEY_ID=k1
OLO_CALLBACK_KEY=change-me-to-a-random-secret-of-32-bytes-or-more

# Chat UI footer (left panel: user label + "tenant: …" line)
OLO_UI_TENANT_DISPLAY_NAME=Default
OLO_UI_USER_DISPLAY_NAME=Public

# Active pipeline definitions (place workflow JSON here manually)
OLO_CONFIGURATION_DIR=../olo-mono/olo-definition/olo-configuration/current-active

# Temporal encryption: a protected file containing tenant keys and decrypt-only rotation keys.
# OLO_PAYLOAD_KEYS_FILE=C:/olo-secrets/payload-keys.json
# Optional remote codec: verified olo-admin role plus membership in the selected tenant is required.
OLO_CODEC_SERVER_ENABLED=false

# Logging (optional)
# LOGGING_LEVEL_ORG_OLO_APP_FILTER_REQUESTLOGGINGFILTER=INFO
